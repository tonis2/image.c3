// coeff_token from the next 16 bits; nc -1 is chroma DC.
fn uint coeff_token(uint bits, int nc) @private
{
	if (nc < 0)
	{
		uint v = CTM1_0[bits >> 13];
		return v != 0 ? v : CTM1_1[bits >> 8];
	}
	if (nc < 2)
	{
		if (bits >= 0x8000) return 0x0001;
		if (bits >= 0x0C00) return CT0_0[bits >> 10];
		if (bits >= 0x0100) return CT0_1[bits >> 6];
		if (bits >= 0x0020) return CT0_2[(bits >> 2) - 8];
		return CT0_3[bits];
	}
	if (nc < 4)
	{
		if (bits >= 0x8000) return (bits & 0x4000) ? 0x0002 : 0x0822;
		if (bits >= 0x1000) return CT2_0[bits >> 10];
		if (bits >= 0x0200) return CT2_1[bits >> 7];
		return CT2_2[bits >> 2];
	}
	if (nc < 8)
	{
		uint v = CT4_0[bits >> 10];
		return v != 0 ? v : CT4_1[bits >> 6];
	}
	return CT8[bits >> 10];
}

// total_zeros from the next 9 bits.
fn uint total_zeros_code(uint bits, uint total, bool chroma_dc) @private
{
	if (chroma_dc)
	{
		bits >>= 6;
		if (bits > 3) return 0x01;
		if (total == 3) return 0x11;
		if (bits > 1) return 0x12;
		if (total == 2) return 0x22;
		return bits ? 0x23 : 0x33;
	}
	switch (total)
	{
		case 1:
			uint v = TZ1_0[bits >> 4];
			return v != 0 ? v : TZ1_1[bits];
		case 2: return TZ2[bits >> 3];
		case 3: return TZ3[bits >> 3];
		case 4: return TZ4[bits >> 4];
		case 5: return TZ5[bits >> 4];
		case 6: return TZ6[bits >> 3];
		case 7: return TZ7[bits >> 3];
		case 8: return TZ8[bits >> 3];
		case 9: return TZ9[bits >> 3];
		case 10: return TZ10[bits >> 4];
		case 11: return TZ11[bits >> 5];
		case 12: return TZ12[bits >> 5];
		case 13: return TZ13[bits >> 6];
		case 14: return TZ14[bits >> 7];
		default: return (bits >> 8) ? 0x11 : 0x01;
	}
}

// run_before from the next 11 bits.
fn uint run_before_code(uint bits, uint zeros_left) @private
{
	switch (zeros_left)
	{
		case 1: return RB1[bits >> 10];
		case 2: return RB2[bits >> 9];
		case 3: return RB3[bits >> 9];
		case 4: return RB4[bits >> 8];
		case 5: return RB5[bits >> 8];
		case 6: return RB6[bits >> 8];
		default:
			uint v;
			if (bits >= 0x100) { v = ((7 - (bits >> 8)) << 4) + 0x3; }
			else if (bits >= 0x80) { v = 0x74; }
			else if (bits >= 0x40) { v = 0x85; }
			else if (bits >= 0x20) { v = 0x96; }
			else if (bits >= 0x10) { v = 0xa7; }
			else if (bits >= 0x8) { v = 0xb8; }
			else if (bits >= 0x4) { v = 0xc9; }
			else if (bits >= 0x2) { v = 0xda; }
			else if (bits) { v = 0xeb; }
			if ((v >> 4) > zeros_left) return 0;
			return v;
	}
}

<*
 One residual block: `out[0..max)` its levels in scan order (zeros elsewhere).
 Returns total_coeff.
*>
fn uint? Bits.residual(&self, int nc, uint max, int* out)
{
	for (uint i = 0; i < max; i++) out[i] = 0;
	uint token = coeff_token(self.peek(16), nc);
	if (token == 0) return CORRUPT~;
	self.skip(token & 0x1F);
	uint total = (token >> 11) & 0x1F;
	uint ones = (token >> 5) & 0x3F;
	if (total == 0) return 0;
	if (total > max) return CORRUPT~;

	int[16] level;
	uint i;
	if (ones > 0)
	{
		uint signs = self.u(ones);
		for (uint m = 1u << (ones - 1); m != 0; m >>= 1) level[i++] = (signs & m) ? -1 : 1;
	}
	uint suffix_length = total > 10 && ones < 3 ? 1 : 0;
	for (; i < total; i++)
	{
		uint b = self.peek(16);
		if (b == 0) return CORRUPT~;
		uint prefix;
		while ((b & 0x8000) == 0)
		{
			prefix++;
			b <<= 1;
		}
		self.skip(prefix + 1);
		uint size;
		if (prefix < 14)
		{
			size = suffix_length;
		}
		else if (prefix == 14)
		{
			size = suffix_length ? suffix_length : 4;
		}
		else
		{
			if (suffix_length == 0) suffix_length = 1;
			size = 12;
		}
		uint code = suffix_length ? prefix << suffix_length : prefix;
		if (size) code += self.u(size);
		if (i == ones && ones < 3) code += 2;
		int value = (int)((code + 2) >> 1);
		if (suffix_length == 0) suffix_length = 1;
		if (value > (3 << (suffix_length - 1)) && suffix_length < 6) suffix_length++;
		level[i] = (code & 1) ? -value : value;
	}

	uint zeros_left;
	if (total < max)
	{
		uint z = total_zeros_code(self.peek(9), total, max == 4);
		if (z == 0) return CORRUPT~;
		self.skip(z & 0xF);
		zeros_left = z >> 4;
	}
	if (total + zeros_left > max) return CORRUPT~;
	int[16] run;
	for (uint k = 0; k + 1 < total; k++)
	{
		if (zeros_left == 0) break;
		uint r = run_before_code(self.peek(11), zeros_left);
		if (r == 0) return CORRUPT~;
		self.skip(r & 0xF);
		run[k] = (int)(r >> 4);
		zeros_left -= r >> 4;
	}
	run[total - 1] = (int)zeros_left;
	int at = -1;
	for (int k = (int)total - 1; k >= 0; k--)
	{
		at += run[k] + 1;
		out[at] = level[k];
	}
	return total;
}
